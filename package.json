{
  "name": "@bclonan/softform",
  "version": "1.3.1",
  "type": "module",
  "description": "Tactile components for Vue, React, and browser-native custom elements",
  "author": {
    "name": "Bradley Clonan",
    "email": "clonanxyz@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bclonan/softform.git"
  },
  "homepage": "https://softform-34r5.netlify.app/",
  "bugs": "https://github.com/bclonan/softform/issues",
  "keywords": [
    "components",
    "design-system",
    "web-components",
    "vue",
    "react",
    "accessible",
    "tree-shaking"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js"
    },
    "./elements": {
      "types": "./dist/elements/index.d.ts",
      "import": "./dist/elements/index.js"
    },
    "./elements/*": {
      "types": "./dist/elements/*.d.ts",
      "import": "./dist/elements/*.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./dictionary": {
      "import": "./dist/component-dictionary.json"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "python scripts/generate-elements.py && python scripts/generate-dictionary.py && python scripts/generate-react.py && vite build && vite build --config vite.lib.config.js && vite build --config vite.elements.config.js && node scripts/copy-types.mjs && node scripts/copy-react.mjs",
    "build-site": "vite build && storybook build && node scripts/copy-storybook.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "build-storybook": "storybook build",
    "check": "npm run test && npm run build && node scripts/check-tree-shaking.mjs && tsc --noEmit --moduleResolution bundler --module esnext --target es2022 --skipLibCheck tests/types-smoke.ts && npm run build-storybook"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/addon-controls": "^8.6.18",
    "@storybook/vue3-vite": "^8.6.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^8.6.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.1",
    "vue": "^3.5.0"
  }
}
